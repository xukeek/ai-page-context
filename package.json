{
  "name": "ai-page-context",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:ext": "pnpm --filter @ai-page-context/extension dev",
    "dev:demo": "pnpm --filter @ai-page-context/react-vite-demo dev",
    "dev:mcp": "pnpm --filter @ai-page-context/mcp-server dev",
    "build": "pnpm -r --filter './packages/*' build",
    "build:ext": "pnpm --filter @ai-page-context/extension build",
    "compile": "pnpm -r --filter './packages/*' compile"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
